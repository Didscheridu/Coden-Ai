        allow create: if isVerified() && isNumId(msgId)
          && exists(/databases/$(database)/documents/apps/$(appId))
          && incoming().keys().hasAll(['id', 'app_id', 'sender', 'role', 'body'])
          && incoming().keys().hasOnly(['id', 'app_id', 'sender', 'owner', 'memberUids', 'role', 'body', 'meta', 'created_at'])
          && incoming().sender == request.auth.uid
          && incoming().role in ['user', 'assistant', 'tool', 'event']
          && isStr(incoming().body, 0, 65000)
          && isOptStr(incoming(), 'owner', 128)
          && (!('memberUids' in incoming()) || (incoming().memberUids is list && incoming().memberUids.size() <= 8))
          && request.auth.uid in get(/databases/$(database)/documents/apps/$(appId)).data.memberUids;
        allow update: if isVerified() && isNumId(msgId)
          && exists(/databases/$(database)/documents/apps/$(appId))
          && (get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid || isAdmin())
          && incoming().keys().hasAll(['id', 'app_id', 'sender', 'role', 'body'])
          && incoming().keys().hasOnly(['id', 'app_id', 'sender', 'owner', 'memberUids', 'role', 'body', 'meta', 'created_at'])
          && incoming().id == existing().id && incoming().app_id == existing().app_id
          && incoming().sender == existing().sender && incoming().role == existing().role
          && incoming().body == existing().body
          && isOptStr(incoming(), 'owner', 128)
          && (!('memberUids' in incoming()) || (incoming().memberUids is list && incoming().memberUids.size() <= 8))
          && incoming().diff(existing()).affectedKeys().hasOnly(['owner', 'memberUids']);
        allow delete: if isNumId(msgId) && (
