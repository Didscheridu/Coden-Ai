        allow create: if isVerified() && isValidId(memberUid)
          && exists(/databases/$(database)/documents/apps/$(appId))
          && incoming().keys().hasAll(['app_id', 'uid', 'role'])
          && incoming().keys().hasOnly(['app_id', 'uid', 'owner', 'memberUids', 'role', 'last_seen'])
          && incoming().uid == memberUid && incoming().role in ['owner', 'editor', 'viewer']
          && isOptStr(incoming(), 'owner', 128)
          && (!('memberUids' in incoming()) || (incoming().memberUids is list && incoming().memberUids.size() <= 8))
          && (get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid || isAdmin());
        allow update: if isVerified() && isValidId(memberUid)
          && incoming().keys().hasAll(['app_id', 'uid', 'role'])
          && incoming().keys().hasOnly(['app_id', 'uid', 'owner', 'memberUids', 'role', 'last_seen'])
          && incoming().uid == existing().uid && incoming().app_id == existing().app_id
          && incoming().role in ['owner', 'editor', 'viewer']
          && isOptStr(incoming(), 'owner', 128)
          && (!('memberUids' in incoming()) || (incoming().memberUids is list && incoming().memberUids.size() <= 8))
          && (
            (get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'last_seen', 'owner', 'memberUids'])) ||
            (isOwner(memberUid) && incoming().diff(existing()).affectedKeys().hasOnly(['last_seen'])) ||
            isAdmin()
          );
        allow delete: if isValidId(memberUid) && (
          isOwner(memberUid) ||
          (exists(/databases/$(database)/documents/apps/$(appId)) && get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid) ||
          isAdmin()
        );
      }

      match /messages/{msgId} {
        allow get: if isNumId(msgId) && isSignedIn() && (
          resource == null ||
          isOwner(existing().sender) ||
          (exists(/databases/$(database)/documents/apps/$(appId)) && request.auth.uid in get(/databases/$(database)/documents/apps/$(appId)).data.memberUids) ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.sender == request.auth.uid ||
          resource.data.owner == request.auth.uid ||
