rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Shared Security Helpers ----------
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'kayden.schunack@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isAdminToken() {
      return isVerified() && request.auth.token.email == 'kayden.schunack@gmail.com';
    }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isNumId(id) {
      return id is string && id.size() >= 1 && id.size() <= 20 && id.matches('^[1-9][0-9]*$');
    }
    function isStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }
    function isOptStr(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }
    function isIsoOrTs(val) {
      return (val is timestamp) || (val is string && val.size() <= 64);
    }

    // ---------- Validation Blueprints ----------
    function isValidUserData(data, uid) {
      return data.keys().hasAll(['uid', 'settings'])
        && data.keys().hasOnly(['uid', 'settings', 'sessionOrder', 'sessions', 'updatedAt'])
        && isStr(data.uid, 1, 128) && data.uid == uid
        && data.settings is map && data.settings.keys().size() <= 40
        && (!('sessionOrder' in data) || (data.sessionOrder is list && data.sessionOrder.size() <= 300))
        && (!('sessions' in data) || (data.sessions is list && data.sessions.size() <= 300))
        && (!('updatedAt' in data) || isIsoOrTs(data.updatedAt));
    }

    function isValidChatSession(data, uid) {
      return data.keys().hasAll(['id', 'uid', 'title', 'messages'])
        && data.keys().hasOnly(['id', 'uid', 'title', 'messages', 'pinned', 'unread', 'projectId', 'assistantId', 'orderIndex', 'createdAt', 'updatedAt'])
        && isStr(data.id, 1, 128)
        && isStr(data.uid, 1, 128) && data.uid == uid
        && isStr(data.title, 0, 200)
        && data.messages is list && data.messages.size() <= 1000
        && (!('pinned' in data) || data.pinned is bool)
        && (!('unread' in data) || data.unread is bool)
        && (!('projectId' in data) || data.projectId == null || data.projectId is int || isStr(data.projectId, 0, 64))
        && (!('assistantId' in data) || data.assistantId == null || isStr(data.assistantId, 0, 128))
        && (!('orderIndex' in data) || data.orderIndex is number)
        && (!('createdAt' in data) || isIsoOrTs(data.createdAt))
        && (!('updatedAt' in data) || isIsoOrTs(data.updatedAt));
    }

    function isValidUserProject(data) {
      return data.keys().hasAll(['id', 'uid', 'name', 'description', 'instructions', 'files', 'color'])
        && data.keys().hasOnly(['id', 'uid', 'name', 'description', 'instructions', 'files', 'color', 'created_at', 'updated_at'])
        && data.id is int && data.id > 0
        && isStr(data.uid, 1, 128)
        && isStr(data.name, 1, 60)
        && isStr(data.description, 0, 300)
        && isStr(data.instructions, 0, 8000)
        && data.files is map && data.files.keys().size() <= 20
        && isStr(data.color, 4, 16)
        && (!('created_at' in data) || isIsoOrTs(data.created_at))
        && (!('updated_at' in data) || isIsoOrTs(data.updated_at));
    }

    function isValidProfile(data, uid) {
      return data.keys().hasAll(['uid', 'handle', 'display_name'])
        && data.keys().hasOnly(['uid', 'handle', 'display_name', 'bio', 'created_at', 'last_seen'])
        && isStr(data.uid, 1, 128) && data.uid == uid
        && isStr(data.handle, 3, 20) && data.handle.matches('^[a-z0-9_]{3,20}$')
        && isStr(data.display_name, 1, 40)
        && isOptStr(data, 'bio', 160)
        && (!('created_at' in data) || isIsoOrTs(data.created_at))
        && (!('last_seen' in data) || isIsoOrTs(data.last_seen));
    }

    function isValidFriendship(data) {
      return data.keys().hasAll(['id', 'requester', 'addressee', 'participants', 'status'])
        && data.keys().hasOnly(['id', 'requester', 'addressee', 'participants', 'status', 'created_at'])
        && isStr(data.id, 3, 260)
        && isStr(data.requester, 1, 128)
        && isStr(data.addressee, 1, 128)
        && data.requester != data.addressee
        && data.participants is list && data.participants.size() == 2
        && data.requester in data.participants && data.addressee in data.participants
        && data.status in ['pending', 'accepted']
        && (!('created_at' in data) || isIsoOrTs(data.created_at));
    }

    function isValidDmMessage(data) {
      return data.keys().hasAll(['id', 'participants', 'sender', 'recipient', 'body'])
        && data.keys().hasOnly(['id', 'participants', 'sender', 'recipient', 'peer', 'ai_for', 'body', 'attachment', 'created_at', 'read_at'])
        && data.id is int && data.id > 0
        && data.participants is list && data.participants.size() == 2
        && isStr(data.sender, 1, 128)
        && isStr(data.recipient, 1, 128)
        && isOptStr(data, 'peer', 128)
        && isOptStr(data, 'ai_for', 128)
        && isStr(data.body, 1, 4500)
        && (!('attachment' in data) || data.attachment == null || (data.attachment is map && data.attachment.keys().size() <= 10))
        && (!('created_at' in data) || isIsoOrTs(data.created_at))
        && (!('read_at' in data) || data.read_at == null || isIsoOrTs(data.read_at));
    }

    function isValidBuddyProject(data) {
      return data.keys().hasAll(['id', 'owner', 'memberUids', 'title'])
        && data.keys().hasOnly(['id', 'owner', 'memberUids', 'title', 'description', 'created_at', 'updated_at'])
        && data.id is int && data.id > 0
        && isStr(data.owner, 1, 128)
        && data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 8
        && data.owner in data.memberUids
        && isStr(data.title, 1, 80)
        && isOptStr(data, 'description', 300)
        && (!('created_at' in data) || isIsoOrTs(data.created_at))
        && (!('updated_at' in data) || isIsoOrTs(data.updated_at));
    }

    function isValidApp(data) {
      return data.keys().hasAll(['id', 'owner', 'memberUids', 'name', 'kind', 'slug', 'preview_token', 'published', 'files', 'version', 'theme_color'])
        && data.keys().hasOnly(['id', 'owner', 'memberUids', 'sharedServerIds', 'name', 'kind', 'style', 'slug', 'preview_token', 'published', 'files', 'integrations', 'version', 'theme_color', 'apk', 'created_at', 'updated_at', 'published_at'])
        && data.id is int && data.id > 0
        && isStr(data.owner, 1, 128)
        && data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 8
        && (!('sharedServerIds' in data) || (data.sharedServerIds is list && data.sharedServerIds.size() <= 30))
        && isStr(data.name, 1, 80)
        && data.kind in ['web', 'ios', 'android', 'both', 'game']
        && isOptStr(data, 'style', 40)
        && isStr(data.slug, 3, 60)
        && isStr(data.preview_token, 8, 64)
        && data.published is bool
        && data.files is map && data.files.keys().size() <= 60
        && (!('integrations' in data) || (data.integrations is map && data.integrations.keys().size() <= 20))
        && data.version is int && data.version >= 1
        && isStr(data.theme_color, 4, 16)
        && (!('apk' in data) || (data.apk is map && data.apk.keys().size() <= 20))
        && (!('created_at' in data) || isIsoOrTs(data.created_at))
        && (!('updated_at' in data) || isIsoOrTs(data.updated_at))
        && (!('published_at' in data) || data.published_at == null || isIsoOrTs(data.published_at));
    }

    function isValidServer(data) {
      return data.keys().hasAll(['id', 'name', 'color', 'owner', 'invite_code', 'memberUids'])
        && data.keys().hasOnly(['id', 'name', 'color', 'owner', 'invite_code', 'memberUids', 'created_at'])
        && data.id is int && data.id > 0
        && isStr(data.name, 1, 40)
        && isStr(data.color, 4, 16)
        && isStr(data.owner, 1, 128)
        && isStr(data.invite_code, 6, 20)
        && data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50
        && (!('created_at' in data) || isIsoOrTs(data.created_at));
    }

    function isValidAiRun(data) {
      return data.keys().hasAll(['id', 'uid', 'kind', 'ref', 'status'])
        && data.keys().hasOnly(['id', 'uid', 'kind', 'ref', 'status', 'text', 'think', 'agents', 'model', 'error', 'meta', 'stop', 'claimed', 'created_at', 'updated_at'])
        && data.id is int && data.id > 0
        && isStr(data.uid, 1, 128)
        && data.kind in ['chat', 'app']
        && isStr(data.ref, 1, 128)
        && data.status in ['running', 'done', 'error', 'stopped']
        && isOptStr(data, 'text', 800000)
        && (!('think' in data) || (data.think is map && data.think.keys().size() <= 10))
        && (!('agents' in data) || (data.agents is list && data.agents.size() <= 30))
        && isOptStr(data, 'model', 160)
        && isOptStr(data, 'error', 2000)
        && (!('meta' in data) || (data.meta is map && data.meta.keys().size() <= 20))
        && (!('stop' in data) || data.stop is bool)
        && (!('claimed' in data) || data.claimed is bool)
        && (!('created_at' in data) || isIsoOrTs(data.created_at))
        && (!('updated_at' in data) || isIsoOrTs(data.updated_at));
    }

    function isValidUsageLimit(data, uid) {
      return data.keys().hasAll(['uid', 's_tokens', 'w_tokens', 'total'])
        && data.keys().hasOnly(['uid', 'email', 's_start', 's_tokens', 'w_start', 'w_tokens', 'total', 'updated_at'])
        && isStr(data.uid, 1, 128) && data.uid == uid
        && isOptStr(data, 'email', 200)
        && (!('s_start' in data) || data.s_start == null || isIsoOrTs(data.s_start))
        && data.s_tokens is number && data.s_tokens >= 0
        && (!('w_start' in data) || data.w_start == null || isIsoOrTs(data.w_start))
        && data.w_tokens is number && data.w_tokens >= 0
        && data.total is number && data.total >= 0
        && (!('updated_at' in data) || isIsoOrTs(data.updated_at));
    }

    function isValidUserModel(data) {
      return data.keys().hasAll(['id', 'uid', 'provider', 'model_id', 'label'])
        && data.keys().hasOnly(['id', 'uid', 'provider', 'model_id', 'label', 'levels', 'default_level', 'created_at'])
        && data.id is int && data.id > 0
        && isStr(data.uid, 1, 128) && data.uid == request.auth.uid
        && data.provider in ['google', 'openai', 'anthropic', 'openrouter', 'numes']
        && isStr(data.model_id, 1, 120) && isStr(data.label, 1, 60)
        && (!('levels' in data) || (data.levels is list && data.levels.size() <= 10))
        && isOptStr(data, 'default_level', 32)
        && (!('created_at' in data) || isIsoOrTs(data.created_at));
    }

    function isValidUserChain(data) {
      return data.keys().hasAll(['id', 'uid', 'name', 'members'])
        && data.keys().hasOnly(['id', 'uid', 'name', 'members', 'created_at'])
        && data.id is int && data.id > 0
        && isStr(data.uid, 1, 128) && data.uid == request.auth.uid
        && isStr(data.name, 1, 40)
        && data.members is list && data.members.size() >= 0 && data.members.size() <= 8
        && (!('created_at' in data) || isIsoOrTs(data.created_at));
    }

    function isValidMcpConnection(data) {
      return data.keys().hasAll(['id', 'uid', 'name', 'url', 'auth_type', 'enabled'])
        && data.keys().hasOnly(['id', 'uid', 'name', 'url', 'catalog_id', 'auth_type', 'enabled', 'header_name', 'token_enc', 'oauth_enc', 'token_expires_at', 'scopes', 'server_name', 'tools', 'status', 'last_error', 'created_at', 'updated_at'])
        && data.id is int && data.id > 0
        && isStr(data.uid, 1, 128)
        && isStr(data.name, 1, 40)
        && isStr(data.url, 8, 500) && data.url.matches('^https://.*')
        && isOptStr(data, 'catalog_id', 64)
        && data.auth_type in ['oauth', 'key', 'none']
        && data.enabled is bool
        && isOptStr(data, 'header_name', 40)
        && isOptStr(data, 'token_enc', 4000)
        && isOptStr(data, 'oauth_enc', 12000)
        && (!('token_expires_at' in data) || data.token_expires_at == null || isIsoOrTs(data.token_expires_at))
        && isOptStr(data, 'scopes', 500)
        && isOptStr(data, 'server_name', 120)
        && (!('tools' in data) || (data.tools is list && data.tools.size() <= 80))
        && (!('status' in data) || data.status in ['connected', 'needs_reauth', 'error'])
        && isOptStr(data, 'last_error', 500)
        && (!('created_at' in data) || isIsoOrTs(data.created_at))
        && (!('updated_at' in data) || isIsoOrTs(data.updated_at));
    }

    // ---------- Connectivity Probe ----------
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // ---------- Admins & System State ----------
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdminToken();
      allow create, update, delete: if isAdmin() && isValidId(uid);
    }

    match /system_state/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if false;
      allow create, update, delete: if isAdmin() && docId == 'global'
        && incoming().keys().hasOnly(['locks', 'broadcast', 'forceUpdate', 'maintenance', 'globalModel', 'theme', 'fontSize', 'globalClear', 'updatedAt']);
    }

    // ---------- User Chat History & Settings (PII-isolated) ----------
    match /user_data/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdminToken();
      allow create: if isVerified() && isValidId(uid) && isValidUserData(incoming(), uid) && (isOwner(uid) || isAdmin());
      allow update: if isVerified() && isValidId(uid) && isValidUserData(incoming(), uid) && (isOwner(uid) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['settings', 'sessionOrder', 'sessions', 'updatedAt']);
      allow delete: if isValidId(uid) && (isOwner(uid) || isAdmin());

      match /sessions/{sessionId} {
        allow get: if isValidId(uid) && isValidId(sessionId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) || isAdminToken();
        allow create: if isVerified() && isValidId(uid) && isValidId(sessionId) && isValidChatSession(incoming(), uid)
          && incoming().id == sessionId && (isOwner(uid) || isAdmin());
        allow update: if isVerified() && isValidId(uid) && isValidId(sessionId) && isValidChatSession(incoming(), uid)
          && incoming().uid == existing().uid && incoming().id == existing().id
          && (isOwner(uid) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messages', 'pinned', 'unread', 'projectId', 'assistantId', 'orderIndex', 'updatedAt']);
        allow delete: if isValidId(uid) && isValidId(sessionId) && (isOwner(uid) || isAdmin());
      }
    }

    // ---------- Private AI Projects ----------
    match /user_projects/{projectId} {
      allow get: if isNumId(projectId) && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdminToken());
      allow create: if isVerified() && isNumId(projectId) && isValidUserProject(incoming())
        && incoming().uid == request.auth.uid;
      allow update: if isVerified() && isNumId(projectId) && isValidUserProject(incoming())
        && (isOwner(existing().uid) || isAdmin())
        && incoming().uid == existing().uid && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'instructions', 'files', 'color', 'updated_at']);
      allow delete: if isNumId(projectId) && (isOwner(existing().uid) || isAdmin());
    }

    // ---------- Code Buddy Profiles & Handles ----------
    match /profiles/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidId(uid) && isValidProfile(incoming(), uid) && isOwner(uid);
      allow update: if isVerified() && isValidId(uid) && isValidProfile(incoming(), uid)
        && (isOwner(uid) || isAdmin())
        && incoming().uid == existing().uid
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['handle', 'display_name', 'bio', 'last_seen']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['last_seen'])
        );
      allow delete: if isValidId(uid) && (isOwner(uid) || isAdmin());
    }

    match /buddy_handles/{handle} {
      allow get: if isSignedIn() && isStr(handle, 3, 20);
      allow list: if false;
      allow create: if isVerified() && isStr(handle, 3, 20) && handle.matches('^[a-z0-9_]{3,20}$')
        && incoming().keys().hasAll(['handle', 'uid']) && incoming().keys().hasOnly(['handle', 'uid'])
        && incoming().handle == handle && incoming().uid == request.auth.uid;
      allow update: if false;
      allow delete: if isVerified() && isStr(handle, 3, 20) && (isOwner(existing().uid) || isAdmin());
    }

    // ---------- Friendships & DMs ----------
    match /friendships/{pairId} {
      allow get: if isSignedIn() && isValidId(pairId) && (request.auth.uid in existing().participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdminToken());
      allow create: if isVerified() && isValidId(pairId) && isValidFriendship(incoming())
        && incoming().requester == request.auth.uid && incoming().id == pairId;
      allow update: if isVerified() && isValidId(pairId) && isValidFriendship(incoming())
        && existing().status == 'pending'
        && (isOwner(existing().addressee) || isAdmin())
        && incoming().requester == existing().requester && incoming().addressee == existing().addressee
        && incoming().participants == existing().participants && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(pairId) && (request.auth.uid in existing().participants || isAdmin());
    }

    match /dm_messages/{msgId} {
      allow get: if isNumId(msgId) && isSignedIn() && (request.auth.uid in existing().participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdminToken());
      allow create: if isVerified() && isNumId(msgId) && isValidDmMessage(incoming())
        && request.auth.uid in incoming().participants
        && (incoming().sender == request.auth.uid || (incoming().sender == 'coden' && incoming().ai_for == request.auth.uid));
      allow update: if isVerified() && isNumId(msgId) && isValidDmMessage(incoming())
        && (isOwner(existing().recipient) || isAdmin())
        && incoming().id == existing().id && incoming().sender == existing().sender
        && incoming().recipient == existing().recipient && incoming().participants == existing().participants
        && incoming().body == existing().body
        && incoming().diff(existing()).affectedKeys().hasOnly(['read_at']);
      allow delete: if isNumId(msgId) && (request.auth.uid in existing().participants || isAdmin());
    }

    // ---------- Collaborative Buddy Projects ----------
    match /buddy_projects/{projectId} {
      function isBpMember() {
        return isSignedIn() && (
          request.auth.uid in existing().memberUids ||
          exists(/databases/$(database)/documents/buddy_projects/$(projectId)/members/$(request.auth.uid))
        );
      }
      allow get: if isNumId(projectId) && (isBpMember() || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberUids || isAdminToken());
      allow create: if isVerified() && isNumId(projectId) && isValidBuddyProject(incoming())
        && incoming().owner == request.auth.uid;
      allow update: if isVerified() && isNumId(projectId) && isValidBuddyProject(incoming())
        && incoming().id == existing().id && incoming().owner == existing().owner
        && (
          (isOwner(existing().owner) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'memberUids', 'updated_at'])) ||
          (isBpMember() && incoming().diff(existing()).affectedKeys().hasOnly(['updated_at'])) ||
          (request.auth.uid in existing().memberUids
            && !(request.auth.uid in incoming().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() - 1
            && existing().memberUids.hasAll(incoming().memberUids)
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updated_at'])) ||
          isAdmin()
        );
      allow delete: if isNumId(projectId) && (isOwner(existing().owner) || isAdmin());

      match /members/{memberUid} {
        allow get: if isValidId(memberUid) && isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.memberUids || isAdmin()
        );
        allow list: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.memberUids || isAdminToken()
        );
        allow create: if isVerified() && isValidId(memberUid)
          && exists(/databases/$(database)/documents/buddy_projects/$(projectId))
          && incoming().keys().hasAll(['project_id', 'uid', 'role'])
          && incoming().keys().hasOnly(['project_id', 'uid', 'role'])
          && incoming().uid == memberUid && incoming().role in ['owner', 'editor']
          && (get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.owner == request.auth.uid || isAdmin());
        allow update: if isVerified() && isValidId(memberUid)
          && incoming().keys().hasAll(['project_id', 'uid', 'role'])
          && incoming().keys().hasOnly(['project_id', 'uid', 'role'])
          && incoming().uid == existing().uid && incoming().project_id == existing().project_id
          && incoming().role in ['owner', 'editor']
          && (get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.owner == request.auth.uid || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['role']);
        allow delete: if isValidId(memberUid) && (
          isOwner(memberUid) || get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.owner == request.auth.uid || isAdmin()
        );
      }

      match /files/{fileKey} {
        allow get: if isValidId(fileKey) && isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.memberUids || isAdmin()
        );
        allow list: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.memberUids || isAdminToken()
        );
        allow create: if isVerified() && isValidId(fileKey)
          && exists(/databases/$(database)/documents/buddy_projects/$(projectId))
          && incoming().keys().hasAll(['project_id', 'name', 'content', 'version', 'updated_by'])
          && incoming().keys().hasOnly(['project_id', 'name', 'content', 'version', 'updated_by', 'updated_at'])
          && isStr(incoming().name, 1, 100) && isStr(incoming().content, 0, 250000)
          && incoming().version is int && incoming().version == 1
          && incoming().updated_by == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.memberUids;
        allow update: if isVerified() && isValidId(fileKey)
          && incoming().keys().hasAll(['project_id', 'name', 'content', 'version', 'updated_by'])
          && incoming().keys().hasOnly(['project_id', 'name', 'content', 'version', 'updated_by', 'updated_at'])
          && incoming().project_id == existing().project_id && incoming().name == existing().name
          && isStr(incoming().content, 0, 250000)
          && incoming().version is int && incoming().version == existing().version + 1
          && incoming().updated_by == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'version', 'updated_by', 'updated_at'])
          && request.auth.uid in get(/databases/$(database)/documents/buddy_projects/$(projectId)).data.memberUids;
