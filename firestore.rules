        && incoming().id == existing().id && incoming().owner == existing().owner
        && (
          (isOwner(existing().owner) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'kind', 'style', 'slug', 'preview_token', 'published', 'published_at', 'files', 'integrations', 'version', 'theme_color', 'apk', 'memberUids', 'sharedServerIds', 'updated_at'])) ||
          (exists(/databases/$(database)/documents/apps/$(appId)/members/$(request.auth.uid))
