          (existing().status == 'running' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'text', 'think', 'agents', 'model', 'error', 'meta', 'stop', 'claimed', 'updated_at'])) ||
          (existing().status != 'running' && existing().claimed == false && incoming().claimed == true && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['claimed', 'updated_at']))
        );
      allow delete: if isNumId(runId) && (isOwner(existing().uid) || isAdmin());
