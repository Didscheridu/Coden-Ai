{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/a/:slug",
      "destination": "/api"
    },
    {
      "source": "/a/:slug/",
      "destination": "/api"
    },
    {
      "source": "/a/:slug/:rest*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 800,
      "includeFiles": "{kit/**,db/schema.sql}"
    }
  }
}
